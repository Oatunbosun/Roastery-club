{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile representation in The Roastery Club",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "order": {
      "title": "Order",
      "description": "Customer beverage and food checkout order",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "orderType": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "tip": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 32 },
        "deliveryAddress": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["customerName", "customerEmail", "total", "status"]
    },
    "reservation": {
      "title": "Reservation",
      "description": "Table or lounge reservation booking",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 256 },
        "phone": { "type": "string", "maxLength": 32 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "guests": { "type": "number" },
        "seatingArea": { "type": "string", "maxLength": 64 },
        "specialRequests": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["customerName", "customerEmail", "date", "time", "guests"]
    },
    "contactMessage": {
      "title": "ContactMessage",
      "description": "Feedback or contact message from visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "Registered user accounts and profile data"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Placed orders and purchases"
    },
    "/reservations/{reservationId}": {
      "schema": "reservation",
      "description": "Table bookings and lounge appointments"
    },
    "/contact_messages/{messageId}": {
      "schema": "contactMessage",
      "description": "Customer contact submissions"
    }
  }
}
